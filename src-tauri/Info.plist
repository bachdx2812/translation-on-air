<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Background agent: no dock icon / no app menu at the bundle level. The
       runtime ActivationPolicy::Accessory already does this for dev + bundle;
       this is belt-and-suspenders for the packaged .app. Tauri merges this file
       into the generated Info.plist at build time. -->
  <key>LSUIElement</key>
  <true/>

  <!-- Right-click selected text in any app → Services → Translate with Translate
       On Air. Secondary to the selection bubble (selection.rs): macOS defaults
       third-party Services to DISABLED, so the bubble is the primary UX. NSMessage
       names the provider selector (services.rs); NSPortName must match the app
       (bundle) name so the OS can route the request. NSSendTypes uses the modern
       UTI (public.utf8-plain-text) — the legacy NSStringPboardType name no longer
       matches text selections on recent macOS. NSKeyEquivalent gives ⌘⌃T. -->
  <key>NSServices</key>
  <array>
    <dict>
      <key>NSMenuItem</key>
      <dict>
        <key>default</key>
        <string>Translate with Translate On Air</string>
      </dict>
      <key>NSMessage</key>
      <string>translateSelection</string>
      <key>NSPortName</key>
      <string>Translate On Air</string>
      <key>NSKeyEquivalent</key>
      <dict>
        <key>default</key>
        <string>@^t</string>
      </dict>
      <key>NSSendTypes</key>
      <array>
        <string>public.utf8-plain-text</string>
        <string>public.plain-text</string>
        <string>NSStringPboardType</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
