{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Translate On Air",
  "version": "0.4.1",
  "identifier": "com.bachdx.translateonair",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "popup",
        "url": "index.html#/popup",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "center": true,
        "resizable": false,
        "width": 460,
        "height": 180,
        "focus": false
      },
      {
        "label": "settings",
        "create": false,
        "url": "index.html#/settings",
        "visible": false,
        "title": "Cài đặt",
        "width": 500,
        "height": 700,
        "minWidth": 440,
        "minHeight": 400,
        "center": true,
        "alwaysOnTop": true
      },
      {
        "label": "bubble",
        "create": false,
        "url": "index.html#/bubble",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "focus": false,
        "width": 104,
        "height": 40
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
